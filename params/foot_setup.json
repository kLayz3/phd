		"det_pos": [19.0, 19.0, 119.0, 119.0, 255.0, 255.0, 345.0, 345.0],
		"dx": 0.0, // Small offset in x- direction 
		"dy": 0.0, // Small offset in x- direction
		"da": 0.0, // Small offset in x- angle relative to the TPCs' defined axis.
		"db": 0.0  // Small offset in y- angle relative to the TPCs' defined axis.
	},
	"FOOT10": {
		"N": 0,             // Detector's unique index in the data, also in the `box.det_pos` array
		"dz": 0.0,          // Small offset in nominally stated position in "box" entry, along the z-axis. Positive `dz` means farther away from Be target
		"orientation": "y", // Orientation, defined by TPCs' y-axis
		"mirrored": false,  // can be rotated and mirrored
		"c_threshold": 4.0, //      Central Threshold (sigma units)
		"n_threshold": 1.5, // Neighbouring Threshold (sigma units)
		"delta_a": 0.0,     // Offset in its measuring dimension [strip units; 150 um]
		"delta_p": 0.0,     // Offset in angle [mrad]	
		"gain": {         // Entry related to the gain matching across the detector
			"fit": [ // Per asic: Nth degree spline describing the behaviour per ASIC. Check the writeup section `Gain Correction`
			/* ASIC[0] */ [1555.34], // not enough statistics; taken as default.
			/* ASIC[1] */ [1555.34], // not enough statistics; taken as default.
			/* ASIC[2] */ [1464],
			/* ASIC[3] */ [1545],
			/* ASIC[4] */ [269384, -3709.91, 19.2564, -0.0443829, 3.8323e-05],
			/* ASIC[5] */ [297585, -3412.49, 14.7267, -0.0281979, 2.02112e-05],
			/* ASIC[6] */ [1557],
			/* ASIC[7] */ [1555.34], // not enough statistics; taken as default.
			/* ASIC[8] */ [1555.34], // not enough statistics; taken as default.
			/* ASIC[9] */ [1555.34]  // not enough statistics; taken as default.
			] // ^^ Correction is calcualted as RAW position (double) [-0.5, 639.5], and then depending on ⌊x/64⌋ take that polynomial.
		}, 
		   // If left empty, then the only parameter is `mean`. Otherwise `mean` doesn't come into the play, if the full polynomial is given.
		"de": {          // Delta correction parameters
			"s": 0.2932, // Position of side peak (mean)
			"f": 0.5172, // Roughly Amplitude factor difference
			"f2": {
				"n": 80, // Number of points in [-0.5, 0.5] that made into the FFT
				"c": [[-0.0269436, 0], [0.0480482, -0.00011105], [0.048119, -0.00517857], [-0.0413567, 0.00674628], [0.00441922, -0.00124], [0.00927885, -0.000201443], [0.0043261, -0.000655142]]
			} /*     ^^^^^ Fourier components for 2nd round of delta-correction. First component is approx. 0 (DC offset) */
		}
	},
